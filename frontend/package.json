{
  "name": "kafka-tool-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node ../desktop/scripts/sync-frontend.mjs",
    "typecheck": "vue-tsc -b",
    "test:json": "npm run typecheck && node --test src/utils/json.test.mjs",
    "test:base64": "npm run typecheck && node --test src/utils/base64.test.mjs",
    "test:tools": "npm run typecheck && node --test src/utils/*.test.mjs",
    "test:frontend": "npm run typecheck && node --test src/utils/*.test.mjs src/stores/*.test.mjs"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.8"
  }
}
